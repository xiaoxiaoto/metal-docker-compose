+    raw = os.getenv(name, "")
+    if raw == "":
+        return ()
+    selected = tuple(raw.split(","))
+    if any(not item or item != item.strip() for item in selected) or len(set(selected)) != len(selected):
+        raise ValueError(
+            f"{name} must contain distinct nonempty CSV names, got {raw!r}"
+        )
+    return selected
