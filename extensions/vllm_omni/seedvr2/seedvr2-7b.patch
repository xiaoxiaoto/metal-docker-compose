--- /dev/null
+++ b/vllm_omni/diffusion/models/seedvr2/comfy.py
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM-Omni project
+"""Comfy-Org/SeedVR2 普通 7B FP16 的显式选择与严格 safetensors 加载。"""
+
+import json
+from pathlib import Path
+
+import torch
+from safetensors import safe_open
+
+COMFY_VARIANT = "7b-comfy-fp16"
+CONDITIONING_SHAPES = {"positive_conditioning": (58, 5120), "negative_conditioning": (64, 5120)}
+
+
+def seedvr2_variant(model: str) -> str | None:
+    index = Path(model) / "model_index.json"
+    if not index.is_file():
+        return None  # 上游 3B 仓库仍沿用原有入口。
+    metadata = json.loads(index.read_text())
+    variant = metadata.get("seedvr2_variant")
+    if variant is not None and variant != COMFY_VARIANT:
+        raise ValueError(f"Unsupported SeedVR2 variant: {variant!r}")
+    if variant == COMFY_VARIANT and metadata.get("_class_name") != "SeedVR2Pipeline":
+        raise ValueError("Comfy SeedVR2 7B requires _class_name=SeedVR2Pipeline")
+    return variant
+
+
+def validate_conditioning(name: str, tensor: torch.Tensor) -> None:
+    if tuple(tensor.shape) != CONDITIONING_SHAPES[name] or tensor.dtype != torch.bfloat16:
+        raise ValueError(f"Invalid SeedVR2 {name}: requires BF16 {CONDITIONING_SHAPES[name]}")
+    if not torch.isfinite(tensor).all():
+        raise ValueError(f"Nonfinite SeedVR2 {name}")
+
+
+def read_comfy_conditioning(checkpoint: Path) -> dict[str, torch.Tensor]:
+    # 只取两项小张量；不读取 DiT 全量参数、不执行缓存中的 pickle。
+    result = {}
+    with safe_open(str(checkpoint), framework="pt", device="cpu") as handle:
+        keys = set(handle.keys())
+        for name in CONDITIONING_SHAPES:
+            if name not in keys:
+                raise ValueError(f"Missing SeedVR2 conditioning key: {name}")
+            tensor = handle.get_tensor(name)
+            validate_conditioning(name, tensor)
+            result[name] = tensor
+    return result
+
+
+def load_seedvr2_weights(module, weights, conditioning=None) -> set[str]:
+    targets = module.state_dict()
+    loaded = set()
+    consumed = set()
+    with torch.no_grad():
+        for name, weight in weights:
+            if conditioning is not None and name.startswith("transformer."):
+                key = name.removeprefix("transformer.")
+                if key in CONDITIONING_SHAPES:
+                    if key in consumed:
+                        raise ValueError(f"Duplicate SeedVR2 conditioning key: {name}")
+                    validate_conditioning(key, weight)
+                    if not torch.equal(weight.cpu(), conditioning[key]):
+                        raise ValueError(f"SeedVR2 conditioning changed after initialization: {name}")
+                    consumed.add(key)
+                    continue
+            if name.endswith(".rope.rope.freqs"):
+                name = name.removesuffix(".rope.rope.freqs") + ".rope.freqs"
+            if name not in targets or name in loaded:
+                raise ValueError(f"Unexpected or duplicate SeedVR2 checkpoint key: {name}")
+            if targets[name].shape != weight.shape:
+                raise ValueError(f"SeedVR2 checkpoint shape mismatch for {name}")
+            if conditioning is not None and weight.dtype != torch.float16:
+                raise ValueError(f"SeedVR2 7B checkpoint dtype mismatch for {name}: expected float16")
+            targets[name].copy_(weight)
+            loaded.add(name)
+    missing = targets.keys() - loaded
+    if missing:
+        raise ValueError(f"Missing SeedVR2 checkpoint keys: {sorted(missing)}")
+    if conditioning is not None and consumed != CONDITIONING_SHAPES.keys():
+        raise ValueError(f"Missing SeedVR2 conditioning keys: {sorted(CONDITIONING_SHAPES.keys() - consumed)}")
