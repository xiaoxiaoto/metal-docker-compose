+class NaVideoRotaryEmbedding3d(NaMMRotaryEmbedding3d):
+    """7B reference pixel RoPE: video only, no text offset or text rotation."""
+
+    mm = False
+
+    def __init__(self, rotary_dim: int) -> None:
+        nn.Module.__init__(self)
+        self.rotary_dim = int(rotary_dim)
+        self.num_axes = 3
+        self.axis_dim = self.rotary_dim // 3
+        self.rot_dim = (self.axis_dim // 2) * 2 * 3
+        if self.rot_dim < 6:
+            raise ValueError("SeedVR2 pixel RoPE needs at least one frequency per axis")
+        self.register_buffer("freqs", torch.linspace(1.0, 128.0, self.axis_dim // 2) * math.pi)
+        self._axis_cache = {}
+
+    def _table(self, dims: tuple[int, ...], *, device, dtype) -> torch.Tensor:
+        axes = []
+        for axis, dim in enumerate(dims):
+            positions = torch.linspace(-1.0, 1.0, steps=dim, device=self.freqs.device)
+            angles = self._axis_angles(positions, device=device, dtype=dtype)
+            shape = [1] * len(dims) + [angles.shape[-1]]
+            shape[axis] = dim
+            axes.append(angles.reshape(shape))
+        return torch.cat(torch.broadcast_tensors(*axes), dim=-1)
+
+    def window_freqs(self, window_shape, text_len, *, device, dtype):
+        return self._table(window_shape, device=device, dtype=dtype).reshape(-1, self.rot_dim)
+
+    def text_freqs(self, text_len, *, device, dtype):
+        return torch.empty((text_len, 0), device=device, dtype=dtype)
+
+    def forward(self, vid_q, vid_k, vid_freqs, txt_q, txt_k, txt_freqs):
+        vid_q = apply_rotary_emb(vid_freqs, vid_q.transpose(0, 1)).transpose(0, 1)
+        vid_k = apply_rotary_emb(vid_freqs, vid_k.transpose(0, 1)).transpose(0, 1)
         return vid_q, vid_k, txt_q, txt_k
 
 
