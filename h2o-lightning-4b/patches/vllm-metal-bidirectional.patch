+# SPDX-License-Identifier: Apache-2.0
+"""Honor HF ``head_dtype=float32`` without converting stored model weights.
+
+Only ordinary MLX Linear/Embedding heads resolved by the model adapter are
+supported. Native and split forwards must agree at load time, including logit
+postprocessing; custom compute_logits, quantization, and LoRA are rejected.
+Embedding lookup remains in the checkpoint dtype. Projection casts vocabulary
+slices transiently, not an entire persistent FP32 copy of a tied vocabulary.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import mlx.core as mx
+import mlx.nn as nn
+
+from vllm_metal.v1.model_adapter import ModelAdapter
+
+# At hidden size 2560 this bounds a temporary FP32 weight slice to 10 MiB.
+_VOCAB_SLICE_ROWS = 1024
+
+
+def _field(config: Any, name: str) -> Any:
+    return config.get(name) if isinstance(config, dict) else getattr(config, name, None)
+
+
+def _requests_float32_head(model_config: Any) -> bool:
+    config = _field(model_config, "hf_config")
+    text_config = _field(config, "text_config")
+    values = [
+        value
+        for node in (config, text_config)
+        if (value := _field(node, "head_dtype")) is not None
+    ]
+    if not values:
+        return False
+    if any(value != "float32" for value in values):
+        raise ValueError(
+            "Metal supports only head_dtype='float32'; conflicting or unsupported "
+            f"HF head_dtype values: {values!r}"
+        )
+    return True
+
+
+def _project_float32(
+    hidden: mx.array, weight: mx.array, bias: mx.array | None = None
+) -> mx.array:
+    if hidden.dtype not in (mx.bfloat16, mx.float16, mx.float32):
+        raise ValueError("FP32 output projection requires floating-point hidden states")
+    if hidden.ndim < 1 or hidden.shape[-1] != weight.shape[1]:
+        raise ValueError("FP32 output projection hidden-state shape does not match weight")
+    hidden = hidden.astype(mx.float32)
+    parts = []
+    for start in range(0, weight.shape[0], _VOCAB_SLICE_ROWS):
+        stop = start + _VOCAB_SLICE_ROWS
+        part_weight = weight[start:stop].astype(mx.float32)
+        if bias is None:
+            part = hidden @ part_weight.T
+        else:
+            part = mx.addmm(bias[start:stop].astype(mx.float32), hidden, part_weight.T)
+        # MLX is lazy: evaluating each slice releases its cast weight before the
+        # next slice, instead of materializing the full vocabulary in FP32.
+        mx.eval(part)
+        parts.append(part)
+    return parts[0] if len(parts) == 1 else mx.concatenate(parts, axis=-1)
+
+
+class Float32OutputEmbedding(nn.Embedding):
+    """Unchanged lookup/storage, with a genuinely FP32 tied projection."""
+
+    def __init__(self, embedding: nn.Embedding) -> None:
+        nn.Module.__init__(self)
+        self.weight = embedding.weight
+
+    def as_linear(self, hidden: mx.array) -> mx.array:
+        return _project_float32(hidden, self.weight)
+
+
+class Float32OutputLinear(nn.Linear):
+    """Unchanged weight/bias storage, with a genuinely FP32 affine projection."""
+
+    def __init__(self, linear: nn.Linear) -> None:
+        nn.Module.__init__(self)
+        self.weight = linear.weight
+        if "bias" in linear:
+            self.bias = linear.bias
+
+    def __call__(self, hidden: mx.array) -> mx.array:
+        return _project_float32(hidden, self.weight, self.get("bias"))
+
+
+def _validate_weight(head: nn.Module) -> None:
+    weight = head.weight
+    if (
+        weight.ndim != 2
+        or min(weight.shape) == 0
+        or weight.dtype not in (mx.bfloat16, mx.float16, mx.float32)
+    ):
+        raise ValueError("head_dtype='float32' requires a nonempty floating-point matrix")
+    bias = head.get("bias")
+    if bias is not None and (
+        bias.shape != (weight.shape[0],)
+        or bias.dtype not in (mx.bfloat16, mx.float16, mx.float32)
+    ):
+        raise ValueError("head_dtype='float32' requires a floating-point vocabulary bias")
+
+
+def install_output_head(
+    model: Any,
+    adapter: ModelAdapter,
+    *,
+    model_config: Any,
+    lora_config: Any = None,
+) -> None:
+    """Install the requested precision contract after checkpoint dtype conversion.
+
+    No-head-dtype models are untouched. The same module handles full, selected,
+    multimodal, and decode projection; the adapter still owns row selection and
+    logit postprocessing. A native/split parity probe rejects head bypasses and
+    postprocessing the adapter cannot reproduce, rather than silently rounding
+    back to the backbone dtype. This probe runs only at model load, before paged
+    attention contexts exist. No compilation or persistent FP32 weights are used.
+    """
+    if not _requests_float32_head(model_config):
+        return
+    if lora_config is not None:
+        raise ValueError("Metal head_dtype='float32' does not support LoRA")
+    config = _field(model_config, "hf_config")
+    if _field(model_config, "quantization") or any(
+        _field(node, "quantization_config") is not None
+        for node in (config, _field(config, "text_config"))
+    ):
+        raise ValueError("Metal head_dtype='float32' does not support quantized models")
+    if isinstance(model, nn.Module) and any(
+        isinstance(module, (nn.QuantizedLinear, nn.QuantizedEmbedding))
+        for _, module in model.named_modules()
+    ):
+        raise ValueError("Metal head_dtype='float32' does not support quantized models")
+
+    text_model = adapter.text_model(model)
+    if hasattr(text_model, "compute_logits"):
+        raise ValueError("Metal head_dtype='float32' does not support custom compute_logits")
+    args = getattr(text_model, "args", None)
+    tied = bool(
+        getattr(text_model, "tie_word_embeddings", False)
+        or getattr(args, "tie_word_embeddings", False)
+    )
+    head = getattr(text_model, "lm_head", None)
+    replacement: nn.Module
+    if tied or head is None:
+        # Reuse the adapter's text-model resolution, including VLM wrappers.
+        backbone = getattr(text_model, "model", None)
+        head = getattr(backbone, "embed_tokens", None)
+        if type(head) is not nn.Embedding:
+            raise ValueError(
+                "Metal head_dtype='float32' requires an ordinary nn.Embedding tied head"
+            )
+        owner, name = backbone, "embed_tokens"
+        _validate_weight(head)
+        replacement = Float32OutputEmbedding(head)
+    else:
+        if type(head) is not nn.Linear:
+            raise ValueError(
+                "Metal head_dtype='float32' requires an ordinary nn.Linear output head"
+            )
+        owner, name = text_model, "lm_head"
+        _validate_weight(head)
+        replacement = Float32OutputLinear(head)
+
+    setattr(owner, name, replacement)
+    if not adapter.supports_selective_logits(text_model):
+        setattr(owner, name, head)
+        raise ValueError(
+            "Metal head_dtype='float32' requires native/split output-head parity; "
+            "the model bypasses the supported projection or has unsupported "
+            "logit postprocessing"
+        )
