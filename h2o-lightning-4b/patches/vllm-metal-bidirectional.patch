+@pytest.mark.parametrize("with_image", [False, True])
+def test_request_full_prompt_mixed_batch_matches_sdpa(
+    with_image, force_tiled_prefill
+) -> None:
+    """The flagged segment sees future keys; its causal/image neighbour does not."""
+    from vllm_metal.attention.impls.sdpa import _mm_prefix_rows
+
+    n, hd = 32, 64
+    key, value, query, _ = _setup(42, n=2 * n, seq_len=n, hd=hd)
+    table = mx.array([[1, 2], [3, 4]], dtype=mx.int32)
+    image = [None, [(8, 16)]] if with_image else None
+    ctx = PagedAttentionContext(
+        slot_mapping=[],
+        cu_seqlens=[0, n, 2 * n],
+        context_lens=[n, n],
+        full_prompt_bidi_ranges=[[(0, n)], None],
+        segment_bidi_ranges=image,
+        bidi_layer_kinds=frozenset({"sliding"}) if with_image else frozenset(),
+    )
+    full_rows = _mm_prefix_rows(ctx, "full")
+    common = dict(kv_lens=[n, n], cu_seqlens_q=[0, n, 2 * n], window=None)
+    plain = _kernel(query, key, value, table, **common)
+    got = _kernel(query, key, value, table, ranges=full_rows, **common)
+    keys = mx.array(_rows(key, [1, 2], 0, n), dtype=DTYPE).transpose(1, 0, 2)[None]
+    values = mx.array(_rows(value, [1, 2], 0, n), dtype=DTYPE).transpose(1, 0, 2)[None]
+    expected = mx.fast.scaled_dot_product_attention(
+        query[:n].transpose(1, 0, 2)[None], keys, values, scale=hd**-0.5
+    )[0].transpose(1, 0, 2)
+    mx.eval(expected)
+    np.testing.assert_allclose(np.array(got[:n]), np.array(expected), atol=ATOL, rtol=RTOL)
+    np.testing.assert_array_equal(np.array(got[n:]), np.array(plain[n:]))
+    assert np.max(np.abs(np.array(got[:n]) - np.array(plain[:n]))) > 0.1
+
+    recomputed = apply_bidirectional_segments(
+        plain, query, key, value, block_tables=table, block_size=BLOCK,
+        block_stride=key[0].size, cu_seqlens=[0, n, 2 * n],
+        context_lens=[n, n], ctx=ctx, window=None, scale=hd**-0.5,
+        head_dim=hd, softcap=0.0, sinks=None, turboquant=False,
+        segment_ranges=ctx.bidirectional_ranges("full"),
+    )
+    mx.eval(recomputed)
+    np.testing.assert_allclose(np.array(got), np.array(recomputed), atol=ATOL, rtol=RTOL)
+
+    # Full rows must not leak through the image-only cache, in either order.
+    assert ctx.bidirectional_ranges("sliding") == image
+    if with_image:
+        sliding_rows = _mm_prefix_rows(ctx, "sliding")
+        sliding = _kernel(
+            query, key, value, table, ranges=sliding_rows,
+            kv_lens=[n, n], cu_seqlens_q=[0, n, 2 * n], window=16,
+        )
+        reference = _reference(
+            query[n:], key, value, [3, 4], q_lo=0, seq_len=n,
+            blocks=[(8, 16)], window=16,
+        )
+        np.testing.assert_allclose(np.array(sliding[n:]), reference, atol=ATOL, rtol=RTOL)
+        np.testing.assert_array_equal(
+            np.array(full_rows), np.array(_mm_prefix_rows(ctx, "full"))
+        )
