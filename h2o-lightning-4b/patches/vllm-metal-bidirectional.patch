diff --git a/tests/test_output_head.py b/tests/test_output_head.py
new file mode 100644
index 0000000..5d86bce
--- /dev/null
+++ b/tests/test_output_head.py
@@ -0,0 +1,276 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Numerical contracts for HF FP32 output heads on real MLX Metal arrays."""
+
+from types import SimpleNamespace
+
+import mlx.core as mx
+import mlx.nn as nn
+import numpy as np
+import pytest
+
+from vllm_metal.v1.model_adapter import DefaultModelAdapter
+from vllm_metal.v1.output_head import install_output_head
+
+
+@pytest.fixture(autouse=True)
+def _metal_device():
+    if not mx.metal.is_available():
+        pytest.skip("MLX Metal is not available")
+    previous = mx.default_device()
+    mx.set_default_device(mx.gpu)
+    yield
+    mx.set_default_device(previous)
+
+
+class _Backbone(nn.Module):
+    def __init__(self, vocab: int, hidden: int):
+        super().__init__()
+        self.embed_tokens = nn.Embedding(vocab, hidden)
+        self.embed_tokens.weight = mx.sin(
+            mx.arange(vocab * hidden, dtype=mx.float32).reshape(vocab, hidden) * 0.31
+        ).astype(mx.bfloat16)
+        self.scale = mx.array(1.125, dtype=mx.bfloat16)
+
+    def __call__(self, ids, cache=None):
+        return self.embed_tokens(ids) * self.scale
+
+
+class _Model(nn.Module):
+    def __init__(self, *, tied=True, bias=False, vocab=23, softcap=None):
+        super().__init__()
+        self.args = SimpleNamespace(tie_word_embeddings=tied)
+        self.model = _Backbone(vocab, 17)
+        if not tied:
+            self.lm_head = nn.Linear(17, vocab, bias=bias)
+            self.lm_head.weight = mx.cos(
+                mx.arange(vocab * 17, dtype=mx.float32).reshape(vocab, 17) * 0.23
+            ).astype(mx.bfloat16)
+            if bias:
+                self.lm_head.bias = mx.sin(mx.arange(vocab) * 0.11).astype(mx.bfloat16)
+        self.final_logit_softcapping = softcap
+
+    def __call__(self, ids, cache=None):
+        hidden = self.model(ids, cache=cache)
+        if self.args.tie_word_embeddings:
+            logits = self.model.embed_tokens.as_linear(hidden)
+        else:
+            logits = self.lm_head(hidden)
+        cap = self.final_logit_softcapping
+        return logits if cap is None else mx.tanh(logits / cap) * cap
+
+
+def _config(**hf_fields):
+    return SimpleNamespace(hf_config=SimpleNamespace(**hf_fields), quantization=None)
+
+
+def _reference(model, hidden):
+    head = model.model.embed_tokens if model.args.tie_word_embeddings else model.lm_head
+    logits = hidden.astype(mx.float32) @ head.weight.astype(mx.float32).T
+    if "bias" in head:
+        logits = logits + head.bias.astype(mx.float32)
+    cap = model.final_logit_softcapping
+    return logits if cap is None else mx.tanh(logits / cap) * cap
+
+
+def _assert_fp32_close(actual, expected):
+    assert actual.dtype == mx.float32
+    np.testing.assert_allclose(np.array(actual), np.array(expected), rtol=2e-6, atol=2e-6)
+
+
+@pytest.mark.parametrize("tied,bias", [(True, False), (False, False), (False, True)])
+@pytest.mark.parametrize("softcap", [None, 3.0])
+def test_native_selected_and_decode_match_fp32_not_bf16_projection(tied, bias, softcap):
+    model = _Model(tied=tied, bias=bias, softcap=softcap)
+    adapter = DefaultModelAdapter()
+    ids = mx.array([[1, 3, 5]], dtype=mx.int32)
+    hidden = model.model(ids)
+    low_precision = model(ids).astype(mx.float32)
+    expected = _reference(model, hidden)
+    # Prove this fixture detects the tempting BF16-matmul-then-cast non-fix.
+    assert mx.max(mx.abs(expected - low_precision)).item() > 1e-4
+    original_weight = model.model.embed_tokens.weight
+    original_scale = model.model.scale
+    original_bytes = np.array(original_weight.view(mx.uint16)).tobytes()
+    lookup = model.model.embed_tokens(ids)
+
+    install_output_head(model, adapter, model_config=_config(head_dtype="float32"))
+
+    _assert_fp32_close(model(ids), expected)
+    _assert_fp32_close(adapter.project_logits(model, hidden), expected)
+    indices = mx.array([0, 2], dtype=mx.int32)
+    _assert_fp32_close(
+        adapter.project_logits(model, hidden, logits_indices=indices),
+        expected[:, [0, 2], :],
+    )
+    output = adapter.target_forward(model, ids, logits_indices=indices)
+    _assert_fp32_close(output.logits, expected[:, [0, 2], :])
+    _assert_fp32_close(model(ids[:, -1:]), _reference(model, model.model(ids[:, -1:])))
+    assert model.model.embed_tokens.weight is original_weight
+    assert model.model.scale is original_scale
+    assert model.model.embed_tokens(ids).dtype == mx.bfloat16
+    assert (
+        np.array(model.model.embed_tokens.weight.view(mx.uint16)).tobytes()
+        == original_bytes
+    )
+    assert bool(mx.array_equal(lookup, model.model.embed_tokens(ids)).item())
+
+
+@pytest.mark.parametrize("tied", [True, False])
+def test_projection_spans_vocabulary_slices_without_changing_stored_weights(tied):
+    model = _Model(tied=tied, bias=not tied, vocab=1027)
+    head = model.model.embed_tokens if tied else model.lm_head
+    weight = head.weight
+    bias = head.get("bias")
+    ids = mx.array([[1, 7]], dtype=mx.int32)
+    expected = _reference(model, model.model(ids))
+
+    install_output_head(
+        model, DefaultModelAdapter(), model_config=_config(head_dtype="float32")
+    )
+
+    _assert_fp32_close(model(ids), expected)
+    head = model.model.embed_tokens if tied else model.lm_head
+    assert head.weight is weight
+    assert head.get("bias") is bias
+    assert head.weight.dtype == mx.bfloat16
+    assert set(head.keys()) == ({"weight"} if tied else {"weight", "bias"})
+
+
+def test_nested_vlm_head_contract_uses_the_same_projection():
+    text_model = _Model()
+    model = SimpleNamespace(language_model=text_model)
+    config = _config(text_config={"head_dtype": "float32"})
+    ids = mx.array([[2, 6]], dtype=mx.int32)
+    expected = _reference(text_model, text_model.model(ids))
+    adapter = DefaultModelAdapter()
+
+    install_output_head(model, adapter, model_config=config)
+
+    _assert_fp32_close(text_model(ids), expected)
+    _assert_fp32_close(adapter.project_logits(model, text_model.model(ids)), expected)
+
+
+def test_missing_head_dtype_does_not_mutate_or_probe_model():
+    model = _Model()
+    embedding = model.model.embed_tokens
+    ids = mx.array([[2]], dtype=mx.int32)
+    reference = model(ids)
+    # An object without adapter methods proves that no precision probe ran.
+    install_output_head(model, object(), model_config=_config())
+    assert model.model.embed_tokens is embedding
+    assert model(ids).dtype == mx.bfloat16
+    assert bool(mx.array_equal(model(ids), reference).item())
+
+
+@pytest.mark.parametrize(
+    "fields",
+    [
+        {"head_dtype": "bfloat16"},
+        {"head_dtype": "float16"},
+        {"head_dtype": "float32", "text_config": {"head_dtype": "bfloat16"}},
+        {"head_dtype": "bfloat16", "text_config": {"head_dtype": "float32"}},
+    ],
+)
+def test_unsupported_or_conflicting_head_dtype_is_rejected(fields):
+    with pytest.raises(ValueError, match="head_dtype"):
+        install_output_head(
+            _Model(), DefaultModelAdapter(), model_config=_config(**fields)
+        )
+
+
+@pytest.mark.parametrize(
+    "combination",
+    [
+        "lora",
+        "quantization",
+        "quantized_head",
+        "custom_head",
+        "compute_logits",
+        "bad_bias",
+    ],
+)
+def test_unsupported_head_combinations_are_rejected(combination):
+    model = _Model(tied=False, bias=True)
+    config = _config(head_dtype="float32")
+    kwargs = {}
+    if combination == "lora":
+        kwargs["lora_config"] = object()
+    elif combination == "quantization":
+        config.hf_config.quantization_config = {"quant_method": "awq"}
+    elif combination == "quantized_head":
+        model.lm_head = nn.QuantizedLinear(64, 23, group_size=64)
+    elif combination == "custom_head":
+
+        class CustomLinear(nn.Linear):
+            pass
+
+        model.lm_head = CustomLinear(17, 23)
+    elif combination == "compute_logits":
+        model.compute_logits = lambda hidden: hidden
+    elif combination == "bad_bias":
+        model.lm_head.bias = mx.zeros((22,))
+    with pytest.raises(ValueError, match="head_dtype"):
+        install_output_head(model, DefaultModelAdapter(), model_config=config, **kwargs)
+
+
+class _BypassingModel(_Model):
+    def __call__(self, ids, cache=None):
+        hidden = self.model(ids, cache=cache)
+        return hidden @ self.model.embed_tokens.weight.T
+
+
+class _ScalingModel(_Model):
+    def __call__(self, ids, cache=None):
+        return super().__call__(ids, cache=cache) * 2.0
+
+
+@pytest.mark.parametrize("model_type", [_BypassingModel, _ScalingModel])
+def test_unsupported_native_head_semantics_fail_loading(model_type):
+    model = model_type()
+    original_embedding = model.model.embed_tokens
+    with pytest.raises(ValueError, match="native/split"):
+        install_output_head(
+            model, DefaultModelAdapter(), model_config=_config(head_dtype="float32")
+        )
+    assert model.model.embed_tokens is original_embedding
+
+
+@pytest.mark.parametrize("invalid", ["shape", "dtype"])
+def test_invalid_projection_input_is_rejected(invalid):
+    model = _Model()
+    install_output_head(
+        model, DefaultModelAdapter(), model_config=_config(head_dtype="float32")
+    )
+    bad_hidden = (
+        mx.zeros((2, 16))
+        if invalid == "shape"
+        else mx.zeros((2, 17), dtype=mx.int32)
+    )
+    with pytest.raises(ValueError, match="hidden"):
+        model.model.embed_tokens.as_linear(bad_hidden)
+
+
+@pytest.mark.parametrize("invalid", ["empty", "integer", "rank"])
+def test_invalid_head_weight_is_rejected(invalid):
+    model = _Model()
+    model.model.embed_tokens.weight = {
+        "empty": mx.zeros((0, 17)),
+        "integer": mx.zeros((23, 17), dtype=mx.int32),
+        "rank": mx.zeros((23,)),
+    }[invalid]
+    with pytest.raises(ValueError, match="head_dtype"):
+        install_output_head(
+            model, DefaultModelAdapter(), model_config=_config(head_dtype="float32")
+        )
+
+
+@pytest.mark.parametrize("tied", [True, False])
+def test_single_hidden_vector_preserves_linear_projection_semantics(tied):
+    model = _Model(tied=tied, bias=not tied)
+    hidden = model.model(mx.array([[3]], dtype=mx.int32))[0, 0]
+    expected = _reference(model, hidden)
+    install_output_head(
+        model, DefaultModelAdapter(), model_config=_config(head_dtype="float32")
+    )
+    project = model.model.embed_tokens.as_linear if tied else model.lm_head
+    _assert_fp32_close(project(hidden), expected)
