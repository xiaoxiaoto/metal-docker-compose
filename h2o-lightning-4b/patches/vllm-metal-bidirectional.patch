index 0000000..82c00c9
--- /dev/null
+++ b/vllm_metal/attention/request_mode.py
@@ -0,0 +1,120 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Explicit whole-prompt attention contract shared by API and worker."""
+
+from __future__ import annotations
+
+from typing import Any
+
+_MODE_ALIASES = {
+    "causal": "causal",
+    "one-way": "causal",
+    "one_way": "causal",
+    "oneway": "causal",
+    "bidirectional": "bidirectional",
+    "two-way": "bidirectional",
+    "two_way": "bidirectional",
+    "twoway": "bidirectional",
+}
+
+
+def attention_mode(params: Any) -> str:
+    extra = getattr(params, "extra_args", None) or {}
+    if "attention_mode" not in extra:
+        return "causal"
+    value = extra["attention_mode"]
+    if not isinstance(value, str) or value.strip().lower() not in _MODE_ALIASES:
+        raise ValueError(
+            "attention_mode must be causal or bidirectional "
+            "(one-way/two-way aliases accepted)"
+        )
+    return _MODE_ALIASES[value.strip().lower()]
+
+
+def validate_bidirectional_config(config: Any, *, backend: str, turboquant: bool) -> bool:
+    add = config.additional_config or {}
+    enabled = add.get("bidirectional_attention", False)
+    if not isinstance(enabled, bool):
+        raise ValueError("additional_config.bidirectional_attention must be a boolean")
+    if not enabled:
+        return False
+    cache = config.cache_config
+    scheduler = config.scheduler_config
+    parallel = config.parallel_config
+    model = config.model_config
+    unsupported = []
+    for name, invalid in (
+        ("MLX backend required", backend != "mlx"),
+        (
+            "unquantized KV required",
+            turboquant or bool(add.get("turboquant")) or cache.cache_dtype != "auto",
+        ),
+        ("--no-enable-prefix-caching required", cache.enable_prefix_caching),
+        ("--no-enable-chunked-prefill required", scheduler.enable_chunked_prefill),
+        ("--mamba-cache-mode none required", cache.mamba_cache_mode != "none"),
+        (
+            "max_num_batched_tokens must cover a positive max_model_len",
+            model.max_model_len <= 0
+            or scheduler.max_num_batched_tokens < model.max_model_len,
+        ),
+        ("speculative decoding unsupported", config.speculative_config is not None),
+        (
+            "pipeline/tensor/data parallelism unsupported",
+            parallel.pipeline_parallel_size != 1
+            or parallel.tensor_parallel_size != 1
+            or parallel.data_parallel_size != 1,
+        ),
+        (
+            "KV transfer unsupported",
+            getattr(config, "kv_transfer_config", None) is not None,
+        ),
+        ("generate runner required", model.runner_type != "generate"),
+        ("MLA unsupported", bool(getattr(model, "is_deepseek_mla", False))),
+    ):
+        if invalid:
+            unsupported.append(name)
+    if unsupported:
+        raise ValueError("bidirectional_attention: " + "; ".join(unsupported))
+    return True
+
+
+def validate_bidirectional_request(params: Any, *, enabled: bool) -> bool:
+    if attention_mode(params) == "causal":
+        return False
+    if not enabled:
+        raise ValueError(
+            "bidirectional attention is not enabled "
+            "(additional_config.bidirectional_attention)"
+        )
+    if params.max_tokens != 1:
+        raise ValueError(
+            "bidirectional attention requires max_tokens=1 (single-token readout)"
+        )
+    return True
+
+
+def whole_prompt_ranges(
+    prefills: Any, decodes: Any, *, enabled: bool
+) -> list[list[tuple[int, int]] | None] | None:
+    """Reject cached/chunked/decode work before any KV writes occur."""
+    for _, state in decodes:
+        if validate_bidirectional_request(state.sampling_params, enabled=enabled):
+            raise RuntimeError(
+                "bidirectional request reached decode; "
+                "only fresh whole-prompt prefill is supported"
+            )
+    ranges: list[list[tuple[int, int]] | None] = [None] * len(decodes)
+    for request in prefills:
+        if not validate_bidirectional_request(request.sampling_params, enabled=enabled):
+            ranges.append(None)
+            continue
+        n = len(request.token_ids)
+        if request.start_pos != 0 or request.prompt_len != n or n == 0:
+            raise RuntimeError(
+                "bidirectional attention requires fresh whole-prompt prefill: "
+                "cached prefixes and intermediate chunks are unsupported"
+            )
+        full = request.full_prompt_token_ids
+        if full is not None and full != request.token_ids:
+            raise RuntimeError("bidirectional prefill does not match the complete prompt")
+        ranges.append([(0, n)])
+    return ranges if any(ranges) else None
